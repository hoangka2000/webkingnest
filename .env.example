# Copy to Vercel Environment Variables (Project Settings → Environment Variables)

# PostgreSQL (Neon / Supabase / Vercel Postgres)
# Example Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/kingnest?sslmode=require
DATABASE_URL=

# Gmail SMTP (order notifications to store)
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_NOTIFY_TO=your@gmail.com
MAIL_FROM_NAME=Kingnest Đơn Hàng

# Optional: public site URL for SEO (sitemap, canonical). Auto-detected from VERCEL_URL if unset.
# SITE_URL=https://your-domain.com

# Google Search Console verification code (optional)
# GOOGLE_SITE_VERIFICATION=your-google-verification-code

# Optional: override checkout redirect base URL (auto-detected from VERCEL_URL on Vercel)
# APP_CHECKOUT_BASE_URL=https://your-domain.vercel.app

# Cloudinary CDN
CLOUDINARY_CLOUD_NAME=ln22f4im
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=Kingnest
